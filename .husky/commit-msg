#!/usr/bin/env sh
# Commit message lint (Conventional Commits) + strip AI-author trailers.
# (Your commit-msg hook may be generated by husky; this content is the
# baseline. Adjust the sed expression if your org uses a different trailer.)
npx --no -- commitlint --edit "$1"
sed -i '/^Co-authored-by: Copilot/d' "$1"
sed -i '/^Co-authored-by: Claude/d' "$1"